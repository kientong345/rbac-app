                {
                    "name": "6. GET /me đúng token -> 200, có permissions, không có passwordHash",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 200, có permissions, ẩn passwordHash', () => {",
                                    "  pm.response.to.have.status(200);",
                                    "  const body = pm.response.json();",
                                    "  pm.expect(body.permissions).to.be.an('array');",
                                    "  pm.expect(body.passwordHash).to.be.undefined;",
                                    "  pm.expect(body._id).to.be.undefined;",
                                    "  pm.expect(body.id).to.be.a('string');",
                                    "  pm.collectionVariables.set('superAdminUserId', body.id);",
                                    "});"
                                ]
                            }
