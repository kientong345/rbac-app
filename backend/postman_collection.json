                        "pm.test('201 Created', () => pm.response.to.have.status(201));",
                        "const body = pm.response.json();",
                        "pm.test('Có Location, không lộ passwordHash/_id', () => {",
                        "  pm.expect(pm.response.headers.get('Location')).to.include(`/users/${body.id}`);",
                        "  pm.expect(body).to.not.have.property('passwordHash');",
                        "  pm.expect(body).to.not.have.property('_id');",
                        "  pm.expect(body.status).to.eql('active');",
                        "});",
                        "pm.collectionVariables.set('t06UserId', body.id);",
                        "pm.collectionVariables.set('t06Email', body.email);",
                        "pm.collectionVariables.set('t06FullName', body.fullName);"
                    ] } }],
                    "request": {
                        "method": "POST",
                        "header": [
