                },
                {
                    "name": "U02. POST /users tạo user mới (user-manager) -> 201 Created",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 201 Created', () => {",
                                    "  pm.response.to.have.status(201);",
                                    "  const body = pm.response.json();",
                                    "  pm.expect(body.passwordHash).to.be.undefined;",
                                    "  pm.collectionVariables.set('createdUserId', body.id);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{userManagerToken}}" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"testuser.rbac@sis.hust.edu.vn\",\n  \"password\": \"TestUser@2026\",\n  \"fullName\": \"Test RBAC User\",\n  \"phone\": \"+84909998877\",\n  \"roleIds\": [\"{{memberRoleId}}\"]\n}"
                        },
                        "url": "{{baseUrl}}/users"
                    }
                },
                {
                    "name": "U03. PUT /users/:userId/roles/:roleId chống leo thang (user-manager gán super-admin) -> 403 PRIVILEGE_ESCALATION",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 403 PRIVILEGE_ESCALATION', () => {",
                                    "  pm.response.to.have.status(403);",
                                    "  pm.expect(pm.response.json().error.code).to.eql('PRIVILEGE_ESCALATION');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "PUT",
                        "header": [{ "key": "Authorization", "value": "Bearer {{userManagerToken}}" }],
                        "url": "{{baseUrl}}/users/{{createdUserId}}/roles/{{superAdminRoleId}}"
                    }
                },
                {
                    "name": "U04. PATCH /users/:userId tự khóa chính mình -> 403 SELF_ACTION_FORBIDDEN",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 403 SELF_ACTION_FORBIDDEN', () => {",
                                    "  pm.response.to.have.status(403);",
                                    "  pm.expect(pm.response.json().error.code).to.eql('SELF_ACTION_FORBIDDEN');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "PATCH",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{superAdminToken}}" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"status\": \"locked\"\n}"
                        },
                        "url": "{{baseUrl}}/users/{{superAdminUserId}}"
                    }
                },
                {
                    "name": "U05. DELETE /users/:userId tự xóa chính mình -> 403 SELF_ACTION_FORBIDDEN",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 403 SELF_ACTION_FORBIDDEN', () => {",
                                    "  pm.response.to.have.status(403);",
                                    "  pm.expect(pm.response.json().error.code).to.eql('SELF_ACTION_FORBIDDEN');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "DELETE",
                        "header": [{ "key": "Authorization", "value": "Bearer {{superAdminToken}}" }],
                        "url": "{{baseUrl}}/users/{{superAdminUserId}}"
                    }
                },
                {
                    "name": "U06. DELETE /users/:userId xóa user vừa tạo -> 204 No Content",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 204 No Content', () => pm.response.to.have.status(204));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "DELETE",
                        "header": [{ "key": "Authorization", "value": "Bearer {{superAdminToken}}" }],
                        "url": "{{baseUrl}}/users/{{createdUserId}}"
                    }
                }
            ]
        }
    ]
}
