{
    "info": {
        "name": "RBAC — Test cases bắt buộc T01–T24 (Mục IV.1)",
        "description": "Chạy `npm run seed` trước, sau đó Run collection theo đúng thứ tự (Setup → T01…T24). Các request sau dùng token/id lưu ở request trước. Email tạo mới có {{$timestamp}} nên chạy lại nhiều lần không cần seed lại.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        { "key": "baseUrl", "value": "http://localhost:3001/api/v1" },
        { "key": "password", "value": "Admin@2026" },
        { "key": "superAdminEmail", "value": "20225000@sis.hust.edu.vn" },
        { "key": "userManagerEmail", "value": "20225001@sis.hust.edu.vn" },
        { "key": "auditorEmail", "value": "20225002@sis.hust.edu.vn" },
        { "key": "memberEmail", "value": "20225005@sis.hust.edu.vn" },
        { "key": "newUserPassword", "value": "Password@2026" },
        { "key": "superAdminToken", "value": "" },
        { "key": "userManagerToken", "value": "" },
        { "key": "auditorToken", "value": "" },
        { "key": "memberToken", "value": "" },
        { "key": "userManagerUserId", "value": "" },
        { "key": "superAdminRoleId", "value": "" },
        { "key": "userManagerRoleId", "value": "" },
        { "key": "auditorRoleId", "value": "" },
        { "key": "memberRoleId", "value": "" },
        { "key": "customRoleId", "value": "" },
        { "key": "t06UserId", "value": "" },
        { "key": "t06Email", "value": "" },
        { "key": "t06FullName", "value": "" },
        { "key": "userAId", "value": "" },
        { "key": "userAEmail", "value": "" },
        { "key": "userAToken", "value": "" }
    ],
    "item": [
        {
            "name": "00. Setup — 4 token + id vai trò",
            "item": [
                {
                    "name": "Login super-admin",
                    "event": [{ "listen": "test", "script": { "exec": [
                        "pm.test('200 OK', () => pm.response.to.have.status(200));",
                        "pm.collectionVariables.set('superAdminToken', pm.response.json().accessToken);"
                    ] } }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{ \"grantType\": \"password\", \"email\": \"{{superAdminEmail}}\", \"password\": \"{{password}}\" }" },
                        "url": "{{baseUrl}}/auth/tokens"
                    }
                },
                {
                    "name": "Login user-manager",
                    "event": [{ "listen": "test", "script": { "exec": [
                        "pm.test('200 OK', () => pm.response.to.have.status(200));",
                        "pm.collectionVariables.set('userManagerToken', pm.response.json().accessToken);"
                    ] } }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{ \"grantType\": \"password\", \"email\": \"{{userManagerEmail}}\", \"password\": \"{{password}}\" }" },
                        "url": "{{baseUrl}}/auth/tokens"
                    }
                },
                {
                    "name": "Login auditor",
                    "event": [{ "listen": "test", "script": { "exec": [
                        "pm.test('200 OK', () => pm.response.to.have.status(200));",
                        "pm.collectionVariables.set('auditorToken', pm.response.json().accessToken);"
                    ] } }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{ \"grantType\": \"password\", \"email\": \"{{auditorEmail}}\", \"password\": \"{{password}}\" }" },
                        "url": "{{baseUrl}}/auth/tokens"
                    }
                },
                {
                    "name": "Login member",
                    "event": [{ "listen": "test", "script": { "exec": [
                        "pm.test('200 OK', () => pm.response.to.have.status(200));",
                        "pm.collectionVariables.set('memberToken', pm.response.json().accessToken);"
                    ] } }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{ \"grantType\": \"password\", \"email\": \"{{memberEmail}}\", \"password\": \"{{password}}\" }" },
                        "url": "{{baseUrl}}/auth/tokens"
                    }
                },
                {
                    "name": "GET /me (user-manager) → userManagerUserId",
                    "event": [{ "listen": "test", "script": { "exec": [
                        "pm.test('200 OK', () => pm.response.to.have.status(200));",
                        "pm.collectionVariables.set('userManagerUserId', pm.response.json().id);"
                    ] } }],
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{userManagerToken}}" }],
                        "url": "{{baseUrl}}/me"
                    }
                },
                {
                    "name": "GET /roles (super-admin) → id vai trò",
                    "event": [{ "listen": "test", "script": { "exec": [
                        "pm.test('200 OK', () => pm.response.to.have.status(200));",
                        "const roles = pm.response.json().data;",
                        "const byCode = (c) => roles.find((r) => r.code === c);",
                        "pm.collectionVariables.set('superAdminRoleId', byCode('super-admin').id);",
                        "pm.collectionVariables.set('userManagerRoleId', byCode('user-manager').id);",
                        "pm.collectionVariables.set('auditorRoleId', byCode('auditor').id);",
                        "pm.collectionVariables.set('memberRoleId', byCode('member').id);",
                        "// Vai trò tự tạo đang được gán (T21, T22) — seed: shift-leader",
                        "const custom = roles.find((r) => !r.isSystem && r.userCount > 0);",
                        "pm.test('Có vai trò tự tạo đang được gán', () => pm.expect(custom).to.be.an('object'));",
                        "pm.collectionVariables.set('customRoleId', custom.id);"
                    ] } }],
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{superAdminToken}}" }],
                        "url": "{{baseUrl}}/roles?limit=100"
                    }
                }
            ]
        },
        {
            "name": "T01–T05 GET /users",
            "item": [
                {
                    "name": "T01 GET /users không token → 401 UNAUTHENTICATED",
                    "event": [{ "listen": "test", "script": { "exec": [
                        "pm.test('401 UNAUTHENTICATED', () => {",
                        "  pm.response.to.have.status(401);",
                        "  pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED');",
                        "});"
                    ] } }],
                    "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/users" }
                },
                {
                    "name": "T02 GET /users (member) → 403 FORBIDDEN",
                    "event": [{ "listen": "test", "script": { "exec": [
                        "pm.test('403 FORBIDDEN', () => {",
                        "  pm.response.to.have.status(403);",
                        "  pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN');",
                        "});"
                    ] } }],
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
                        "url": "{{baseUrl}}/users"
                    }
                },
                {
                    "name": "T03 GET /users?page=2&limit=3&sort=fullName (auditor) → 200, meta đúng",
                    "event": [{ "listen": "test", "script": { "exec": [
                        "pm.test('200 OK', () => pm.response.to.have.status(200));",
                        "const { data, meta } = pm.response.json();",
                        "pm.test('meta đúng', () => {",
                        "  pm.expect(meta.page).to.eql(2);",
                        "  pm.expect(meta.limit).to.eql(3);",
                        "  pm.expect(meta.totalPages).to.eql(Math.max(1, Math.ceil(meta.totalItems / 3)));",
                        "  pm.expect(data.length).to.be.at.most(3);",
                        "});",
                        "pm.test('Sắp xếp tăng dần theo fullName', () => {",
                        "  for (let i = 1; i < data.length; i++) pm.expect(data[i - 1].fullName <= data[i].fullName).to.be.true;",
                        "});"
                    ] } }],
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{auditorToken}}" }],
                        "url": "{{baseUrl}}/users?page=2&limit=3&sort=fullName"
                    }
                },
                {
                    "name": "T04 GET /users?q=nguyen&status=active (auditor) → 200, chỉ bản ghi khớp",
                    "event": [{ "listen": "test", "script": { "exec": [
                        "pm.test('200 OK', () => pm.response.to.have.status(200));",
                        "pm.test('Mọi bản ghi active và chứa \"nguyen\"', () => {",
                        "  pm.response.json().data.forEach((u) => {",
                        "    pm.expect(u.status).to.eql('active');",
                        "    pm.expect(`${u.fullName} ${u.email}`.toLowerCase()).to.include('nguyen');",
                        "  });",
                        "});"
                    ] } }],
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{auditorToken}}" }],
                        "url": "{{baseUrl}}/users?q=nguyen&status=active"
                    }
                },
                {
                    "name": "T05 GET /users?limit=500 (auditor) → 400 INVALID_QUERY_PARAMETER",
                    "event": [{ "listen": "test", "script": { "exec": [
                        "pm.test('400 INVALID_QUERY_PARAMETER', () => {",
                        "  pm.response.to.have.status(400);",
                        "  const err = pm.response.json().error;",
                        "  pm.expect(err.code).to.eql('INVALID_QUERY_PARAMETER');",
                        "  pm.expect(err.details.map((d) => d.field)).to.include('limit');",
                        "});"
                    ] } }],
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{auditorToken}}" }],
                        "url": "{{baseUrl}}/users?limit=500"
                    }
                }
            ]
        },
