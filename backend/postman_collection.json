                            "mode": "raw",
                            "raw": "{\n  \"grantType\": \"password\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"WrongPass@123\"\n}"
                        },
                        "url": "{{baseUrl}}/auth/tokens"
