            "name": "Bước 1: Test Xác thực & /me (Mục III.1.10)",
            "item": [
                {
                    "name": "1. POST /auth/tokens đúng thông tin -> 200, có accessToken",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                                    "const body = pm.response.json();",
                                    "pm.test('Có accessToken và tokenType Bearer', () => {",
                                    "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                                    "  pm.expect(body.tokenType).to.eql('Bearer');",
                                    "});",
                                    "pm.collectionVariables.set('token', body.accessToken);",
                                    "pm.collectionVariables.set('superAdminToken', body.accessToken);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"grantType\": \"password\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
                        },
                        "url": "{{baseUrl}}/auth/tokens"
                    }
                },
                {
                    "name": "2a. POST /auth/tokens sai mật khẩu -> 401 INVALID_CREDENTIALS",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 401 INVALID_CREDENTIALS', () => {",
                                    "  pm.response.to.have.status(401);",
                                    "  const err = pm.response.json().error;",
                                    "  pm.expect(err.code).to.eql('INVALID_CREDENTIALS');",
                                    "  pm.expect(err.message).to.eql('Email hoặc mật khẩu không đúng.');",
                                    "});"
                                ]
                            }
